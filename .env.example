# Copie para .env e preencha. NUNCA faça commit do .env.

# OpenWeatherMap — https://openweathermap.org/api
EXPO_PUBLIC_WEATHER_API_KEY=sua_chave_aqui

# RevenueCat (compras: café e doações) — chaves PÚBLICAS do SDK, em Project > API keys
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxx

# AdMob (opcional: já há padrão no código)
EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-4541742841922750/9142629209
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=ca-app-pub-4541742841922750/6756139011
